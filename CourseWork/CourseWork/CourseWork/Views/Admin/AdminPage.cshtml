@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "AdminPage";
}

@using CourseWork.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@model List<User>

<div class="container my-4">
    <h2 class="mb-4">List of Users</h2>

    <form asp-action="ControlUserAction" method="post">
        <div class="mb-3 d-flex flex-wrap gap-2">
            <button type="submit" name="action" value="block" class="btn btn-warning">Block</button>
            <button type="submit" name="action" value="unblock" class="btn btn-success">Unblock</button>
            <button type="submit" name="action" value="delete" class="btn btn-danger">Delete</button>
            <button type="submit" name="action" value="give_admin" class="btn btn-primary">Give Admin Role</button>
            <button type="submit" name="action" value="remove_admin" class="btn btn-secondary">Remove Admin Role</button>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col"><input type="checkbox" id="select-all" /></th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Last Visit</th>
                        <th scope="col">Status</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><input type="checkbox" name="selectedIds" value="@user.Id" /></td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            @{
                                TimeSpan? ago = user.LastVisit == default ? (TimeSpan?)null : DateTime.UtcNow - user.LastVisit;
                            }
                            <td>
                                @if (ago == null)
                                {
                                    <span class="text-muted">Never</span>
                                }
                                else
                                {
                                    var readable = ago.Value.TotalMinutes < 1 ? "Just now"
                                    : ago.Value.TotalMinutes < 60 ? $"{(int)ago.Value.TotalMinutes} min ago"
                                    : ago.Value.TotalHours < 24 ? $"{(int)ago.Value.TotalHours} hours ago"
                                    : $"{(int)ago.Value.TotalDays} days ago";

                                    <span title="@user.LastVisit.ToLocalTime().ToString("f")">@readable</span>
                                }
                            </td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge bg-warning text-dark">Blocked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                @if (await UserManager.IsInRoleAsync(user, "Admin"))
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById("select-all").addEventListener("click", function () {
            const checkboxes = document.querySelectorAll('input[name="selectedIds"]');
            for (const cb of checkboxes) {
                cb.checked = this.checked;
            }
        });
    </script>
}
