@using CourseWork.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model InventoryCreateViewModel
@{
    ViewData["Title"] = "Create Inventory";
    Layout = "_Layout";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container my-5">
    <h2 class="mb-4">@Localizer["Create New Inventory"]</h2>

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()


        <div class="mb-3">
            <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

  
        <div class="mb-3">
            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

    
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">@Localizer["CategoryId"]</label>
            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                <option value="">@Localizer["Select category"]</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

  
        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" id="IsPublic" />
            <label class="form-check-label" for="IsPublic">
                @Localizer["Public Inventory"].Value
            </label>
        </div>


        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label"></label>
            <input asp-for="ImageFile" type="file" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="tags" class="form-label">@Localizer["Tags"]</label>
            <input asp-for="Tags" placeholder=@Localizer["Enter tags separated by commas"].Value class="form-control" />
            <span asp-validation-for="Tags" class="text-danger"></span>
        </div>

     
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["Create Inventory"]</button>
            <a asp-action="MyInventories" class="btn btn-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
