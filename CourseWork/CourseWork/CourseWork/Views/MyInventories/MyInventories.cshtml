@using CourseWork.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model MyInventoriesViewModel

@{
    ViewData["Title"] = "My Inventories";
    Layout = "_Layout";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Localizer["My Inventories"]</h2>
        <a asp-controller="MyInventories" asp-action="Create" class="btn btn-success">@Localizer["Create New Inventory"]</a>
    </div>

    <form asp-action="DeleteSelected" method="post">
        @Html.AntiForgeryToken()

 
        <h3>@Localizer["My Created Inventories"] (@Model.CreatedInventories.Count)</h3>
        @if (Model.CreatedInventories.Any())
        {
            <div class="mb-2">
                <button type="button" onclick="selectAll('created')" class="btn btn-sm btn-outline-primary me-2">@Localizer["Select All"]</button>
                <button type="button" onclick="clearSelection()" class="btn btn-sm btn-outline-secondary">@Localizer["Clear Selection"]</button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col"><input type="checkbox" id="select-all-created" /></th>
                            <th scope="col">@Localizer["Photo"]</th>
                            <th scope="col">@Localizer["Name"]</th>
                            <th scope="col">@Localizer["Description"]</th>
                            <th scope="col">@Localizer["Items"]</th>
                            <th scope="col">@Localizer["Category"]</th>
                            <th scope="col">@Localizer["Tags"]</th>
                            <th scope="col">@Localizer["Created"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inventory in Model.CreatedInventories)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedInventories" value="@inventory.Id" class="created-checkbox" />
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inventory.ImageUrl))
                                    {
                                        <img src="@inventory.ImageUrl" alt="Photo" class="img-thumbnail" style="width:80px; height:80px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width:80px; height:80px;">
                                            <span class="text-muted small">@Localizer["No photo"]</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inventory.Id">
                                        @inventory.Name
                                    </a>
                                </td>
                                <td>@inventory.Description</td>
                                <td>@inventory.Items.Count</td>
                                <td>@inventory.Category?.Name</td>
                                <td>
                                    @if (inventory.InventoryTags.Any())
                                    {
                                        <span>@string.Join(", ", inventory.InventoryTags.Select(it => it.Tag.Name))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["No tags"]</span>
                                    }
                                </td>
                                <td>@inventory.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <span id="selectedCount">0 @Localizer["inventories selected"]</span>
                <button type="submit" id="deleteButton" class="btn btn-danger" disabled>@Localizer["Delete Selected"]</button>
            </div>
        }
        else
        {
            <p>@Localizer["No inventories created yet"]. <a asp-controller="MyInventories" asp-action="Create">@Localizer["Create your first inventory"]</a></p>
        }

    
        <h3 class="mt-5">@Localizer["Shared With Me"] (@Model.AccessibleInventories.Count)</h3>
        @if (Model.AccessibleInventories.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">@Localizer["Photo"]</th>
                            <th scope="col">@Localizer["Name"]</th>
                            <th scope="col">@Localizer["Description"]</th>
                            <th scope="col">@Localizer["Owner"]</th>
                            <th scope="col">@Localizer["Items"]</th>
                            <th scope="col">@Localizer["Category"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inventory in Model.AccessibleInventories)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(inventory.ImageUrl))
                                    {
                                        <img src="@inventory.ImageUrl" alt="Photo" class="img-thumbnail" style="width:80px; height:80px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width:80px; height:80px;">
                                            <span class="text-muted small">@Localizer["No photo"]</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inventory.Id">@inventory.Name</a>
                                </td>
                                <td>@inventory.Description</td>
                                <td>@inventory.Creator.UserName</td>
                                <td>@inventory.Items.Count</td>
                                <td>@inventory.Category?.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>@Localizer["No shared inventories. Other users can share their inventories with you"].</p>
        }


        <h3 class="mt-5">@Localizer["Public Inventories"] (@Model.PublicInventories.Count)</h3>
        @if (Model.PublicInventories.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">@Localizer["Photo"]</th>
                            <th scope="col">@Localizer["Name"]</th>
                            <th scope="col">@Localizer["Description"]</th>
                            <th scope="col">@Localizer["Owner"]</th>
                            <th scope="col">@Localizer["Items"]</th>
                            <th scope="col">@Localizer["Category"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inventory in Model.PublicInventories)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(inventory.ImageUrl))
                                    {
                                        <img src="@inventory.ImageUrl" alt="Photo" class="img-thumbnail" style="width:80px; height:80px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width:80px; height:80px;">
                                            <span class="text-muted small">@Localizer["No photo"]</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inventory.Id">@inventory.Name</a>
                                </td>
                                <td>@inventory.Description</td>
                                <td>@inventory.Creator.UserName</td>
                                <td>@inventory.Items.Count</td>
                                <td>@inventory.Category?.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>@Localizer["No public inventories. Other users can make their inventories public"].</p>
        }
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById("select-all-created").addEventListener("click", function () {
            const checkboxes = document.querySelectorAll('.created-checkbox');
            for (const cb of checkboxes) {
                cb.checked = this.checked;
            }
            updateSelectedCount();
        });

        function updateSelectedCount() {
            const inventoriesSelectedText = "@Html.Raw(Localizer["inventories selected"].Value)";
            const selected = document.querySelectorAll('.created-checkbox:checked').length;
            document.getElementById('selectedCount').textContent = selected + " " + inventoriesSelectedText;
            document.getElementById('deleteButton').disabled = selected === 0;
        }

        function selectAll(section) {
            const checkboxes = document.querySelectorAll('.created-checkbox');
            for (const cb of checkboxes) {
                cb.checked = true;
            }
            document.getElementById("select-all-created").checked = true;
            updateSelectedCount();
        }

        function clearSelection() {
            const checkboxes = document.querySelectorAll('.created-checkbox');
            for (const cb of checkboxes) {
                cb.checked = false;
            }
            document.getElementById("select-all-created").checked = false;
            updateSelectedCount();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.created-checkbox');
            for (const cb of checkboxes) {
                cb.addEventListener('change', updateSelectedCount);
            }

            document.querySelector('form').addEventListener('submit', function (e) {
                const selected = document.querySelectorAll('.created-checkbox:checked').length;
                if (selected > 0 && !confirm('Are you sure you want to delete ' + selected + ' inventory(ies)?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
