@using CourseWork.Models
@using Microsoft.AspNetCore.Identity
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    bool isCreator = ViewBag.IsCreator ?? false;
    bool isAdmin = User.IsInRole("Admin");
    bool isPublic = ViewBag.isPublic ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
}

<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CourseWork / @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">CourseWork</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">@Localizer["Logout"]</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">@Localizer["Register"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">@Localizer["Login"]</a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="MyInventories" asp-action="MyInventories">@Localizer["My Inventories"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Items" asp-action="Items" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Items"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reviews" asp-action="Reviews" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Chat"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Description" asp-action="Description" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Description"]</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
                    </li>

                    @if (isCreator || isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomId" asp-action="CustomId" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Custom ID"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomField" asp-action="Edit" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Custom Fields"]</a>
                        </li>
                        @if (!isPublic)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Permissions" asp-action="Permissions" asp-route-inventoryId="@ViewBag.InventoryId">@Localizer["Access Control"]</a>
                            </li>
                        }
                    }
                    <li class="nav-item">
                        <button id="langToggle" class="btn btn-outline-secondary ms-2">EN</button>
                    </li>
                    <li class="nav-item">
                        <button id="themeToggle" class="btn btn-outline-secondary ms-2">🌙 / ☀️</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        <h2>@ViewBag.InventoryName</h2>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const html = document.documentElement;
        const btn = document.getElementById('themeToggle');


        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            html.setAttribute('data-bs-theme', savedTheme);
        }

        btn.addEventListener('click', () => {
            let newTheme = html.getAttribute('data-bs-theme') === 'light' ? 'dark' : 'light';
            html.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });
    </script>
    <script>
        const langBtn = document.getElementById('langToggle');

        function getCurrentCulture() {
            const match = document.cookie.match(/\.AspNetCore\.Culture=c=([^|;]+)/);
            return match ? match[1] : 'en';
        }

        function setCultureCookie(culture) {
            document.cookie = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture + "; path=/; max-age=31536000";
        }

        langBtn.textContent = getCurrentCulture().toUpperCase();

        langBtn.addEventListener('click', () => {
            const current = getCurrentCulture();
            const newCulture = current === 'en' ? 'ru' : 'en';
            setCultureCookie(newCulture);

            location.reload();
        });
    </script>
</body>
</html>
