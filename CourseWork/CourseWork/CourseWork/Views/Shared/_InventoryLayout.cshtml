@using CourseWork.Models
@using Microsoft.AspNetCore.Identity
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager

@{
	bool isCreator = ViewBag.IsCreator ?? false;
	bool isAdmin = User.IsInRole("Admin");
	bool isPublic = ViewBag.isPublic ?? false;
	bool canEdit = ViewBag.CanEdit ?? false;
}

<!DOCTYPE html>
<html>
<head>
	<title>CourseWork/@ViewData["Title"]</title>
</head>

<h2>@ViewBag.InventoryName</h2>

<ul>
	@if (SignInManager.IsSignedIn(User))
	{
		<li>
			<form asp-controller="Account" asp-action="Logout">
				<button type="submit">Logout</button>
			</form>
		</li>
	}
	else
	{
		<li>
			<a asp-controller="Account" asp-action="Register">Register</a>
		</li>
		<li>
			<a asp-controller="Account" asp-action="Login">Login</a>
		</li>
	}
	<li>
		<a asp-controller="MyInventories" asp-action="MyInventories">My Inventories</a>
	</li>
	<li>
		<a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@ViewBag.InventoryId">Items</a>
	</li>
	<li>
		<a asp-controller="Reviews" asp-action="Reviews" asp-route-inventoryId="@ViewBag.InventoryId">Chat</a>
	</li>
	<li>
		<a asp-controller="Description" asp-action="Description" asp-route-inventoryId="@ViewBag.InventoryId">Description</a>
	</li>

	@if (isCreator || isAdmin)
	{
		<li>
			<a asp-controller="CustomId" asp-action="CustomId" asp-route-inventoryId="@ViewBag.InventoryId">Custom ID</a>
		</li>
		<li>
			<a asp-controller="CustomField" asp-action="Edit" asp-route-inventoryId="@ViewBag.InventoryId">Custom Fields</a>
		</li>
		@if (!isPublic)
		{
			<li>
				<a asp-controller="Permissions" asp-action="Permissions" asp-route-inventoryId="@ViewBag.InventoryId">Access Control</a>
			</li>
		}
	}
</ul>

<body>
	@RenderBody()

	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
