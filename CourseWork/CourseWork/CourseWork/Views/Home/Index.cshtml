@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CourseWork.Models.ViewModels.HomeViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container my-4">
    <h1 class="mb-4">@Localizer["Welcome"], @User.Identity?.Name</h1>

    <h2 class="mb-3">🔥 @Localizer["Popular Inventories"]</h2>
    @if (Model.PopularInventories.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-4">
            @foreach (var inv in Model.PopularInventories)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(inv.Inventory.ImageUrl))
                        {
                            <img src="@inv.Inventory.ImageUrl" class="card-img-top" alt="@inv.Inventory.Name" style="object-fit:cover; height:200px;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                                <span class="text-muted">@Localizer["No photo"]</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inv.Inventory.Id" class="link-primary">
                                    @inv.Inventory.Name
                                </a>
                            </h5>

                            <p class="text-muted mb-1">
                                @Localizer["Category"]: <strong>@inv.Inventory.Category?.Name</strong>
                            </p>

                            <p class="text-muted mb-2">
                                @Localizer["Tags"]:
                                @if (inv.Inventory.InventoryTags.Any())
                                {
                                    @string.Join(", ", inv.Inventory.InventoryTags.Select(t => t.Tag.Name))
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </p>

                            <p class="card-text mt-auto">
                                @(!string.IsNullOrEmpty(inv.Inventory.Description) ? inv.Inventory.Description : @Localizer["No description"].Value)
                            </p>
                        </div>

                        <div class="card-footer d-flex justify-content-between">
                            <small class="text-muted">👍 @Localizer["Likes"]: @inv.LikesCount</small>
                            <small class="text-muted">📅 @Localizer["Created"]: @inv.Inventory.CreatedAt.ToString("g")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>@Localizer["No popular inventories yet"].</p>
    }

    <h2 class="mb-3">🆕 @Localizer["Latest Inventories"]</h2>
    @if (Model.LatestInventories.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var inv in Model.LatestInventories)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(inv.ImageUrl))
                        {
                            <img src="@inv.ImageUrl" class="card-img-top" alt="@inv.Name" style="object-fit:cover; height:200px;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                                <span class="text-muted">@Localizer["No photo"]</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inv.Id" class="link-primary">
                                    @inv.Name
                                </a>
                            </h5>

                            <p class="text-muted mb-1">
                                @Localizer["Category"]: <strong>@inv.Category?.Name</strong>
                            </p>

                            <p class="text-muted mb-2">
                                @Localizer["Tags"]:
                                @if (inv.InventoryTags.Any())
                                {
                                    @string.Join(", ", inv.InventoryTags.Select(t => t.Tag.Name))
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </p>

                            <p class="card-text mt-auto">
                                @(!string.IsNullOrEmpty(inv.Description) ? inv.Description : @Localizer["No description"].Value)
                            </p>
                        </div>

                        <div class="card-footer">
                            <small class="text-muted">📅 @Localizer["Created"]: @inv.CreatedAt.ToString("g")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>@Localizer["No inventories created yet"].</p>
    }
</div>
