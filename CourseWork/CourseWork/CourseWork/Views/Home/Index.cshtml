@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CourseWork.Models.ViewModels.HomeViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

<h1>Welcome, @User.Identity?.Name</h1>

<h2>🔥 Popular Inventories</h2>
@if (Model.PopularInventories.Any())
{
    <div class="row">
        @foreach (var inv in Model.PopularInventories)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(inv.Inventory.ImageUrl))
                    {
                        <img src="@inv.Inventory.ImageUrl" class="card-img-top" alt="@inv.Inventory.Name" style="object-fit:cover; height:200px;" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                            <span>No photo</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inv.Inventory.Id">
                                @inv.Inventory.Name
                            </a>
                        </h5>

                        <p class="text-muted">
                            Category: <strong>@inv.Inventory.Category?.Name</strong>
                        </p>

                        <p class="text-muted">
                            Tags:
                            @if (inv.Inventory.InventoryTags.Any())
                            {
                                @string.Join(", ", inv.Inventory.InventoryTags.Select(t => t.Tag.Name))
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </p>

                        <p class="card-text">
                            @(!string.IsNullOrEmpty(inv.Inventory.Description) ? inv.Inventory.Description : "No description")
                        </p>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <small class="text-muted">👍 Likes: @inv.LikesCount</small>
                        <small class="text-muted">📅 Created: @inv.Inventory.CreatedAt.ToString("g")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No popular inventories yet.</p>
}


<h2>🆕 Latest Inventories</h2>
@if (Model.LatestInventories.Any())
{
    <div class="row">
        @foreach (var inv in Model.LatestInventories)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(inv.ImageUrl))
                    {
                        <img src="@inv.ImageUrl" class="card-img-top" alt="@inv.Name" style="object-fit:cover; height:200px;" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                            <span>No photo</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inv.Id">
                                @inv.Name
                            </a>
                        </h5>

                        <p class="text-muted">
                            Category: <strong>@inv.Category?.Name</strong>
                        </p>

                        <p class="text-muted">
                            Tags:
                            @if (inv.InventoryTags.Any())
                            {
                                @string.Join(", ", inv.InventoryTags.Select(t => t.Tag.Name))
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </p>

                        <p class="card-text">
                            @(!string.IsNullOrEmpty(inv.Description) ? inv.Description : "No description")
                        </p>
                    </div>

                    <div class="card-footer">
                        <small class="text-muted">📅 Created: @inv.CreatedAt.ToString("g")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No inventories created yet.</p>
}
