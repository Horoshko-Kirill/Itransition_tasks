@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using CourseWork.Models.ViewModels;
@model EditViewModel;

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Profile";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container my-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="width: 100%; max-width: 500px; border-radius: 1.5rem;">

        <h2 class="text-center mb-4">@Localizer["Edit Profile"]</h2>

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <form asp-action="Edit" method="post">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@Localizer["UserName"]</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">@Localizer["FirstName"]</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">@Localizer["LastName"]</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">@Localizer["Save"]</button>
        </form>

        <a asp-action="Profile" class="btn btn-outline-secondary w-100 mt-3">@Localizer["Back to Profile"]</a>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
        }
    </div>
</div>
