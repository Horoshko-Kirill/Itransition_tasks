@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using CourseWork.Models.ViewModels;
@model UserViewModel;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = "Profile";
}


<div class="container my-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="width: 100%; max-width: 500px; border-radius: 1.5rem;">

        <div class="d-flex flex-column align-items-center mb-4">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" alt="Avatar" class="rounded-circle border border-3 border-primary" style="width:180px; height:180px; object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-light border border-3 border-secondary d-flex align-items-center justify-content-center" style="width:180px; height:180px;">
                    <span class="text-muted">@Localizer["No Avatar"]</span>
                </div>
            }
        </div>

        <div class="text-center mb-4">
            <h3 class="mb-1">@Model.UserName</h3>
            <p class="mb-1">@Model.FirstName @Model.LastName</p>
            <p><strong>@Model.Email</strong></p>
        </div>

        <form asp-action="UpdatePhoto" method="post" enctype="multipart/form-data" class="mb-3">
            <input type="file" name="newPhoto" accept="image/*" class="form-control mb-2" />
            <button type="submit" class="btn btn-outline-primary w-100">@Localizer["Update Avatar"]</button>
        </form>

        <a asp-action="Edit" class="btn btn-primary w-100 mb-3">@Localizer["Edit Profile"]</a>


        @if (User.IsInRole("Admin"))
        {
            if (Model.SalesForce == true)
        {
                <button class="btn btn-secondary w-100 mb-3" disabled>
                    @Localizer["User already in CRM"]
                </button>
            }
            else
            {
                <a asp-action="ExportToCRMById" asp-route-id="@ViewBag.Id" class="btn btn-success w-100 mb-3">
                    @Localizer["Export to CRM"]
                </a>
            }
        }
        else
        {
            if (Model.SalesForce == true)
            {
                <button class="btn btn-secondary w-100 mb-3" disabled>
                    @Localizer["You are already in CRM"]
                </button>
            }
            else
            {
                <a asp-action="ExportToCRM" class="btn btn-success w-100 mb-3">
                    @Localizer["Export to CRM"]
                </a>
            }
        }


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }
    </div>
</div>
