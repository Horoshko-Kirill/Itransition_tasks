@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CourseWork.Models.ViewModels.InventoryListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "All Inventories";
}

<div class="container my-4">
    <h2 class="mb-4">All Inventories</h2>


    <form method="get" asp-action="AllInventories" class="row g-3 mb-4 align-items-end">
        <div class="col-12 col-md-4">
            <label for="searchQuery" class="form-label">Search</label>
            <input type="text" name="searchQuery" id="searchQuery" value="@Model.SearchQuery" placeholder="Search by name..." class="form-control" />
        </div>

        <div class="col-6 col-md-3">
            <label for="categoryId" class="form-label">Category</label>
            <select name="categoryId" id="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.CategoryOptions)
                {
                    <option value="@cat.Value"
                            selected="@(Model.SelectedCategoryId == int.Parse(cat.Value) ? "selected" : null)">
                        @cat.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label for="tagId" class="form-label">Tag</label>
            <select name="tagId" id="tagId" class="form-select">
                <option value="">All Tags</option>
                <option value="0" selected="@(Model.SelectedTagId == 0 ? "selected" : null)">No tags</option>
                @foreach (var tag in Model.TagOptions)
                {
                    <option value="@tag.Id"
                            selected="@(Model.SelectedTagId == tag.Id ? "selected" : null)">
                        @tag.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>


    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Category</th>
                    <th scope="col">Tags</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inventory in Model.Inventories)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(inventory.ImageUrl))
                            {
                                <img src="@inventory.ImageUrl" alt="@inventory.Name" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" />
                            }
                            else
                            {
                                <span class="text-muted">No image</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Items" asp-action="Items" asp-route-inventoryId="@inventory.Id" class="link-primary">
                                @inventory.Name
                            </a>
                        </td>
                        <td>@inventory.Description</td>
                        <td>@inventory.Category?.Name</td>
                        <td>
                            @if (inventory.InventoryTags.Any())
                            {
                                @string.Join(", ", inventory.InventoryTags.Select(it => it.Tag.Name))
                            }
                            else
                            {
                                <span class="text-muted">No tags</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
