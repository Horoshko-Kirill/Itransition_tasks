@using CourseWork.Models.ViewModels
@model PermissionsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Manage Permissions";
}

<h2 class="mb-4">Manage Permissions</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Permissions" method="post">
    <input type="hidden" name="inventoryId" value="@Model.InventoryId" />

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>User Name</th>
                    <th class="text-center">Can Edit</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Users.Count; i++)
                {
                    <tr>
                        <td>@Model.Users[i].UserName</td>
                        <td class="text-center">
                            <input type="hidden" name="Users[@i].UserId" value="@Model.Users[i].UserId" />
                            <div class="form-check form-switch d-inline-block">
                                <input class="form-check-input" type="checkbox" name="Users[@i].HaveWriteAccess" value="true" @(Model.Users[i].HaveWriteAccess ? "checked" : "") />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-save me-1"></i> Save Permissions
        </button>
    </div>
</form>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
}
