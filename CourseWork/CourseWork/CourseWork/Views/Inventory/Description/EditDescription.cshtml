@model CourseWork.Models.Inventory
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Edit Inventory";
}

<div class="container my-5">
    <h2 class="mb-4">@Localizer["Edit Inventory"]</h2>

    <form asp-action="EditDescription" method="post" enctype="multipart/form-data">
        <input type="hidden" name="inventoryId" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">@Localizer["Name"]</label>
            <input type="text" name="name" value="@Model.Name" class="form-control" required maxlength="100" />
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Description"]</label>
            <textarea name="description" class="form-control" rows="5" maxlength="2000">@Model.Description</textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Tags (comma separated)"]</label>
            <input type="text" name="tags" class="form-control" value="@ViewBag.TagString" />
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Photo"]</label>
            <input type="file" name="imageFile" class="form-control" />
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.ImageUrl" alt="Current Photo" class="img-fluid rounded" style="max-width:200px; max-height:200px; object-fit:cover;" />
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-success">@Localizer["Save"]</button>
            <a asp-action="Description" asp-route-inventoryId="@Model.Id" class="btn btn-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
