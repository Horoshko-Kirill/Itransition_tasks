@model CourseWork.Models.Inventory
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Edit Inventory";
}

<h2>Edit Inventory</h2>

<form asp-action="EditDescription" method="post" enctype="multipart/form-data">
    <input type="hidden" name="inventoryId" value="@Model.Id" />

    <div class="form-group mb-3">
        <label>Name</label>
        <input type="text" name="name" value="@Model.Name" class="form-control" required maxlength="100" />
    </div>

    <div class="form-group mb-3">
        <label>Description</label>
        <textarea name="description" class="form-control" rows="5" maxlength="2000">@Model.Description</textarea>
    </div>

    <div class="form-group mb-3">
        <label>Tags (comma separated)</label>
        <input type="text" name="tags" class="form-control" value="@ViewBag.TagString" />
    </div>


    <div class="form-group mb-3">
        <label>Photo</label>
        <input type="file" name="imageFile" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mt-2">
                <img src="@Model.ImageUrl" alt="Current Photo" style="max-width:200px; max-height:200px; object-fit:cover;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Description" asp-route-inventoryId="@Model.Id" class="btn btn-secondary">Cancel</a>
</form>
