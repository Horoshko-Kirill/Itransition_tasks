@model CourseWork.Models.Inventory
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Inventory Description";

    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool hasLiked = ViewBag.UserLiked ?? false;
    int likeCount = ViewBag.LikeCount ?? 0;
}

<div class="container my-5">
    <div class="card shadow-sm p-4">
        <h2 class="card-title mb-3">@Model.Name</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="mb-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Inventory Photo" class="img-fluid rounded" style="max-width:300px; max-height:300px; object-fit:cover;" />
            }
            else
            {
                <div class="bg-light text-muted rounded d-flex align-items-center justify-content-center" style="width:300px; height:300px; margin:auto;">
                    No photo
                </div>
            }
        </div>

        <div class="mb-3">
            <strong>Description:</strong>
            <p>@Model.Description</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.TagString))
        {
            <div class="mb-3">
                <strong>Tags:</strong>
                <p>@ViewBag.TagString</p>
            </div>
        }

        <div class="mb-4">
            <form asp-controller="InventoryLikes" asp-action="ToggleLike" method="post" class="d-inline">
                <input type="hidden" name="inventoryId" value="@Model.Id" />
                <button type="submit" class="btn @(hasLiked ? "btn-danger" : "btn-primary")">
                    @(hasLiked ? "Unlike" : "Like") (@likeCount)
                </button>
            </form>

            @if ((ViewBag.isCreator ?? false) || User.IsInRole("Admin"))
            {
                <a asp-action="EditDescription" asp-route-inventoryId="@Model.Id" class="btn btn-secondary ms-2">Edit</a>
            }
        </div>
    </div>
</div>
