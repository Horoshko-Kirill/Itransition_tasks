@model List<CourseWork.Models.Review>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Manage Permissions";
}

<h2>Reviews</h2>

<form asp-action="Create" method="post">
    <input type="hidden" name="inventoryId" value="@ViewBag.inventoryId" />

    <div class="mb-3">
        <label>Rating</label>
        <select name="rating" class="form-control">
            <option value="1">1 ⭐</option>
            <option value="2">2 ⭐⭐</option>
            <option value="3">3 ⭐⭐⭐</option>
            <option value="4">4 ⭐⭐⭐⭐</option>
            <option value="5">5 ⭐⭐⭐⭐⭐</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Review</label>
        <textarea name="content" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Leave review</button>

</form>

<hr />

@foreach (var review in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <strong>@review.User.UserName</strong>
            <span>(@review.Reating ⭐)</span>
            <p>@review.Content</p>
            <small class="text-muted">@review.CreatedAt.ToLocalTime()</small>
        </div>
    </div>
}