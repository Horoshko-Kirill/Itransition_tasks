@model List<CourseWork.Models.Review>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Reviews";
}

<h2 class="mb-4">@Localizer["Reviews"]</h2>

<form asp-action="Create" method="post">
    <input type="hidden" name="inventoryId" value="@ViewBag.inventoryId" />

    <div class="row g-3 mb-3">
        <div class="col-md-3 col-12">
            <label class="form-label">@Localizer["Rating"]</label>
            <select name="rating" class="form-select">
                <option value="1">1 ⭐</option>
                <option value="2">2 ⭐⭐</option>
                <option value="3">3 ⭐⭐⭐</option>
                <option value="4">4 ⭐⭐⭐⭐</option>
                <option value="5">5 ⭐⭐⭐⭐⭐</option>
            </select>
        </div>

        <div class="col-md-9 col-12">
            <label class="form-label">@Localizer["Review"]</label>
            <textarea name="content" class="form-control" rows="2" required></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mb-4">
        <i class="bi bi-chat-left-text me-1"></i> @Localizer["Leave review"]
    </button>
</form>

<hr />

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var review in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>@review.User.UserName</strong>
                        <span class="text-warning">@review.Reating ⭐</span>
                    </div>
                    <p class="card-text">@review.Content</p>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("g")</small>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
}
