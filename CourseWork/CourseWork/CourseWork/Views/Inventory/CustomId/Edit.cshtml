@using CourseWork.Models.Enums
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Custom ID";
}
<link rel="stylesheet" href="~/css/custom-elements.css" />

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <h3>Elements</h3>
    <button type="button" id="add-element" class="btn btn-sm btn-outline-secondary mb-2">Add element</button>

    <ul id="elements-list">
        @if (Model.Elements != null)
        {
            @for (int i = 0; i < Model.Elements.Count; i++)
            {
                var element = Model.Elements[i];
                <li class="element-item" data-index="@i">
                    <div class="d-flex flex-column flex-md-row align-items-start gap-2">
                        <input type="hidden" name="Elements[@i].Id" value="@element.Id" />

                        <select name="Elements[@i].Type" class="form-select form-select-sm flex-shrink-0">
                            @foreach (var t in Enum.GetValues(typeof(CustomIdElementType)))
                            {
                                <option value="@t" @(element.Type == (CustomIdElementType)t ? "selected" : "")>@t</option>
                            }
                        </select>

                        <input name="Elements[@i].FixedValue" value="@element.FixedValue" class="form-control form-control-sm flex-grow-1" />

                        <button type="button" class="emoji-toggle btn btn-sm" style="display:@(element.Type == CustomIdElementType.FixedText ? "inline-block" : "none")">😀</button>
                    </div>

                    <emoji-picker class="emoji-picker mt-1" style="height:250px; display:none;"></emoji-picker>
                    <div class="type-desc small mt-1"></div>
                    <input type="hidden" name="Elements[@i].Order" value="@i" />
                </li>
            }
        }
    </ul>

    <h3 class="mt-3">Preview</h3>
    <div id="preview" class="p-2 rounded mb-3"></div>

    <button type="submit" class="btn btn-success">Save Changes</button>
</form>

@section Scripts {
    <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element/index.js"></script>

    

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const list = document.getElementById('elements-list');
            const addButton = document.getElementById('add-element');
            let draggedItem = null;
            let dragOverItem = null;
            let wasDraggedOut = false;

            const typeDescriptions = {
                FixedText: "You can enter any text or Emoji",
                Random6Digit: "Random 6-digit number",
                Random9Digit: "Random 9-digit number",
                Random20Bit: "Random string of 5 characters",
                Random32Bit: "Random string of 9 characters",
                Guid: "GUID example: 00000000-0000-0000-0000-000000000000",
                DateTime: "Date format (e.g., yyyy, MM, dd)",
                Sequence: "Sequence format (e.g., D3, D8)"
            };

            function generateValue(type) {
                switch(type){
                    case 'Random6Digit': return Math.floor(100000 + Math.random()*900000);
                    case 'Random9Digit': return Math.floor(100000000 + Math.random()*900000000);
                    case 'Random20Bit': return Math.random().toString(36).substring(2,7);
                    case 'Random32Bit': return Math.random().toString(36).substring(2,11);
                    case 'Guid': return '00000000-0000-0000-0000-000000000000';
                    case 'DateTime': return 'yyyy';
                    case 'Sequence': return 'D3';
                    default: return '';
                }
            }

            function setupInputByType(li){
                const select = li.querySelector('select');
                const input = li.querySelector('input[name$=".FixedValue"]');
                const toggleBtn = li.querySelector('.emoji-toggle');
                const emojiPicker = li.querySelector('.emoji-picker');
                const desc = li.querySelector('.type-desc');

                desc.innerText = typeDescriptions[select.value] || '';

                switch(select.value){
                    case 'FixedText':
                        input.readOnly = false;
                        input.placeholder = "Fixed text / Emoji";
                        toggleBtn.style.display = 'inline-block';
                        emojiPicker.style.display = 'none';
                        break;
                    case 'DateTime':
                    case 'Sequence':
                        input.readOnly = false;
                        input.placeholder = '';
                        toggleBtn.style.display = 'none';
                        emojiPicker.style.display = 'none';
                        if(!input.value) input.value = generateValue(select.value);
                        break;
                    default:
                        input.readOnly = true;
                        input.placeholder = '';
                        toggleBtn.style.display = 'none';
                        emojiPicker.style.display = 'none';
                        input.value = generateValue(select.value);
                }
            }

            function updatePreview(){
                const values = Array.from(list.children).map(li => {
                    const input = li.querySelector('input[name$=".FixedValue"]');
                    return input.value || '[text]';
                });
                document.getElementById('preview').innerText = values.join(' -- ');
            }


            function updateOrder(){
                Array.from(list.children).forEach((li, i) => {
                    li.dataset.index = i;
                    li.querySelectorAll("[name]").forEach(input => {
                        input.name = input.name.replace(/Elements\[\d+\]/, `Elements[${i}]`);
                    });
                    li.querySelector('input[name$=".Order"]').value = i;
                });
            }

            function initializeElement(li){
                setupInputByType(li);
                const select = li.querySelector('select');
                select.addEventListener('change', () => {
                    setupInputByType(li);
                    updatePreview();
                });

                const input = li.querySelector('input[name$=".FixedValue"]');
                input.addEventListener('input', () => {
                    if(select.value === 'DateTime'){
                        if(!/^[yMdHhms:\- ]*$/.test(input.value)) input.value = input.value.slice(0,-1);
                    }
                    if(select.value === 'Sequence'){
                        if(!/^D\d*$/.test(input.value)) input.value = input.value.slice(0,-1);
                    }
                    updatePreview();
                });

                li.setAttribute('draggable', 'true');

                li.addEventListener('dragstart', function(e) {
                    draggedItem = this;
                    wasDraggedOut = false;
                    this.style.opacity = '0.5';
                    e.dataTransfer.effectAllowed = 'move';
                    try { e.dataTransfer.setData('text/plain', ''); } catch (err) {}
                });

                li.addEventListener('dragend', function() {
                    this.style.opacity = '1';
                    document.body.style.cursor = '';

                    if (wasDraggedOut) {
                        this.style.transform = 'scale(0)';
                        this.style.opacity = '0';
                        setTimeout(() => {
                            if (this.parentNode) {
                                this.remove();
                                updateOrder();
                                updatePreview();
                            }
                        }, 260);
                    }

                    draggedItem = null;
                    wasDraggedOut = false;
                });

                li.addEventListener('dragover', function(e) { e.preventDefault(); });

                li.addEventListener('dragenter', function(e) {
                    e.preventDefault();
                    if (this !== draggedItem) {
                        dragOverItem = this;
                    }
                });

                li.addEventListener('dragleave', function() {
                    if (this === dragOverItem) {
                        dragOverItem = null;
                    }
                });

                li.addEventListener('drop', function(e) {
                    e.preventDefault();
                    if (this !== draggedItem && draggedItem) {
                        if (draggedItem.parentNode === this.parentNode) {
                            const allItems = Array.from(list.children);
                            const thisIndex = allItems.indexOf(this);
                            const draggedIndex = allItems.indexOf(draggedItem);
                            if (draggedIndex < thisIndex) {
                                list.insertBefore(draggedItem, this.nextSibling);
                            } else {
                                list.insertBefore(draggedItem, this);
                            }
                            updateOrder();
                            updatePreview();
                        }
                    }
                });
            }

            document.addEventListener('dragover', function(e) {
                if (!draggedItem) return;
                const listRect = list.getBoundingClientRect();
                const isOut = (
                    e.clientX < listRect.left - 20 ||
                    e.clientX > listRect.right + 20 ||
                    e.clientY < listRect.top - 20 ||
                    e.clientY > listRect.bottom + 20
                );
                wasDraggedOut = isOut;
                if (isOut) {
                    document.body.style.cursor = 'no-drop';
                } else {
                    document.body.style.cursor = '';
                }
                e.preventDefault();
            });

            document.addEventListener('drop', function(e) { e.preventDefault(); });

            Array.from(list.children).forEach(li => initializeElement(li));
            updatePreview();
            updateOrder();

            addButton.addEventListener('click', function(){
                const index = list.children.length;
                const li = document.createElement('li');
                li.className = 'element-item';
                li.dataset.index = index;
                li.innerHTML = `
                    <input type="hidden" name="Elements[${index}].Id" value="0" />
                    <select name="Elements[${index}].Type" class="type-select">
                        <option value="FixedText">FixedText</option>
                        <option value="Random6Digit">Random6Digit</option>
                        <option value="Random9Digit">Random9Digit</option>
                        <option value="Random20Bit">Random20Bit</option>
                        <option value="Random32Bit">Random32Bit</option>
                        <option value="Guid">Guid</option>
                        <option value="DateTime">DateTime</option>
                        <option value="Sequence">Sequence</option>
                    </select>
                    <input name="Elements[${index}].FixedValue" />
                    <button type="button" class="emoji-toggle" style="display:none;">😀</button>
                    <emoji-picker class="emoji-picker" style="height:300px; display:none;"></emoji-picker>
                    <div class="type-desc"></div>
                    <input type="hidden" name="Elements[${index}].Order" value="${index}" />
                `;
                list.appendChild(li);
                initializeElement(li);
                updateOrder();
                updatePreview();
            });

            list.addEventListener('click', function(e){
                if(e.target.classList.contains('emoji-toggle')){
                    const picker = e.target.closest('li').querySelector('.emoji-picker');
                    picker.style.display = picker.style.display === 'none' ? 'block' : 'none';
                }
            });

            list.addEventListener('emoji-click', function(e){
                const detail = e.detail || {};
                const unicode = detail.unicode;
                const pickerEl = e.target.closest('emoji-picker');
                const li = (pickerEl && pickerEl.closest('li')) || e.target.closest('li');
                if (!li) return;
                const input = li.querySelector('input[name$=".FixedValue"]');
                if (unicode) input.value = unicode;
                if (pickerEl) pickerEl.style.display = 'none';
                updatePreview();
            });
        });
    </script>
}
