@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CourseWork.Models.ViewModels.CustomIdFormatViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Custom ID";
}

<h2>@Localizer["Custom ID Format"]</h2>

@{
    var typeDescriptions = new Dictionary<string, string>
    {
        { "FixedText", Localizer["You can enter any text or Emoji"].Value },
        { "Random6Digit", Localizer["Random 6-digit number"].Value },
        { "Random9Digit", Localizer["Random 9-digit number"].Value },
        { "Random20Bit", Localizer["Random string of 5 characters"].Value },
        { "Random32Bit", Localizer["Random string of 9 characters"].Value },
        { "Guid", Localizer["GUID format"].Value },
        { "DateTime", Localizer["Date format (e.g., yyyy, MM, dd)"].Value },
        { "Sequence", Localizer["Sequence format (e.g., D3, D8)"].Value }
    };

    string preview = Model.Elements != null
        ? string.Join("--", Model.Elements.OrderBy(e => e.Order).Select(e => e.FixedValue))
        : "";
}

@if (Model?.Elements != null && Model.Elements.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["Order"]</th>
                <th>@Localizer["Type"]</th>
                <th>@Localizer["Description"]</th>
                <th>@Localizer["Format"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var el in Model.Elements.OrderBy(e => e.Order))
            {
                var typeName = el.Type.ToString();
                <tr>
                    <td>@el.Order</td>
                    <td>@typeName</td>
                    <td>@typeDescriptions[typeName]</td>
                    <td>@el.FixedValue</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>@Localizer["Preview"]</h3>
    <div>@preview</div>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Edit"]</a>