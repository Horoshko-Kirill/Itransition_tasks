@model CourseWork.Models.Item
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Edit Item";
}

<div class="container my-5">
    <h2 class="mb-4">Edit Item</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="InventoryId" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Image File</label>
            <input type="file" name="imageFile" class="form-control" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="ImageDropboxPath" />
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.ImageUrl" alt="Current Image" class="img-fluid rounded" style="max-height:150px; object-fit:cover;" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="CustomId" class="form-label"></label>
            <input asp-for="CustomId" class="form-control" />
            <span asp-validation-for="CustomId" class="text-danger"></span>
            <div class="form-text">Format will be validated. Preview: @ViewBag.Preview</div>
        </div>

        <h4 class="mb-3">Custom Fields</h4>
        @for (int i = 0; i < Model.CustomFieldValues.Count; i++)
        {
            var fieldValue = Model.CustomFieldValues[i];
            var field = fieldValue.CustomField;

            <div class="mb-3">
                <label class="form-label">@field.Name</label>
                <small class="form-text text-muted d-block mb-1">@field.Description</small>

                @switch (field.FieldType)
                {
                    case CourseWork.Models.Enums.CustomFieldType.SingleLineText:
                        <input type="text" name="CustomFieldValues[@i].Value" value="@fieldValue.Value" class="form-control" required />
                        break;
                    case CourseWork.Models.Enums.CustomFieldType.MultiLineText:
                        <textarea name="CustomFieldValues[@i].Value" class="form-control" required>@fieldValue.Value</textarea>
                        break;
                    case CourseWork.Models.Enums.CustomFieldType.Numeric:
                        <input type="number" name="CustomFieldValues[@i].Value" value="@fieldValue.Value" class="form-control" required />
                        break;
                    case CourseWork.Models.Enums.CustomFieldType.DocumentOrImage:
                        <input type="text" name="CustomFieldValues[@i].Value" class="form-control" placeholder="Paste document/image URL here" />
                        break;
                    case CourseWork.Models.Enums.CustomFieldType.Boolean:
                        <div class="form-check">
                            <input type="hidden" name="CustomFieldValues[@i].Value" value="false" />
                            <input type="checkbox" class="form-check-input" name="CustomFieldValues[@i].Value" value="true" @(fieldValue.Value == "true" ? "checked" : "") id="checkbox-@i" />
                            <label class="form-check-label" for="checkbox-@i">Check if true</label>
                        </div>
                        break;
                }

                <input type="hidden" name="CustomFieldValues[@i].CustomFieldId" value="@field.Id" />
            </div>
        }

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Items" asp-route-inventoryId="@Model.InventoryId" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
