@model CourseWork.Models.Item
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Edit Item";
}

<h2>Edit Item</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InventoryId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Image File</label>
        <input type="file" name="imageFile" class="form-control" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="ImageDropboxPath" />
    </div>

    <div class="form-group">
        <label asp-for="CustomId"></label>
        <input asp-for="CustomId" class="form-control" />
        <span asp-validation-for="CustomId" class="text-danger"></span>
        <span class="form-text text-muted">Format will be validated.</span>
    </div>


    <h4>Custom Fields</h4>
    @for (int i = 0; i < Model.CustomFieldValues.Count; i++)
    {
        var fieldValue = Model.CustomFieldValues[i];
        var field = fieldValue.CustomField;

        <div class="form-group">
            <label>@field.Name</label>
            <small class="form-text text-muted">@field.Description</small>

            @switch (field.FieldType)
            {
                case CourseWork.Models.Enums.CustomFieldType.SingleLineText:
                    <input type="text" name="CustomFieldValues[@i].Value" value="@fieldValue.Value" class="form-control" required />
                    break;
                case CourseWork.Models.Enums.CustomFieldType.MultiLineText:
                    <textarea name="CustomFieldValues[@i].Value" class="form-control" required>@fieldValue.Value</textarea>
                    break;
                case CourseWork.Models.Enums.CustomFieldType.Numeric:
                    <input type="number" name="CustomFieldValues[@i].Value" value="@fieldValue.Value" class="form-control" required />
                    break;
                case CourseWork.Models.Enums.CustomFieldType.DocumentOrImage:
                    <input type="file" name="CustomFieldValues[@i].Value" class="form-control" required />
                    break;
                case CourseWork.Models.Enums.CustomFieldType.Boolean:
                    <input type="hidden" name="CustomFieldValues[@i].Value" value="false" />
                    <input type="checkbox" name="CustomFieldValues[@i].Value" value="true" @(fieldValue.Value == "true" ? "checked" : "") />
                    break;
            }

            <input type="hidden" name="CustomFieldValues[@i].CustomFieldId" value="@field.Id" />
        </div>
    }


    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Items" asp-route-inventoryId="@Model.InventoryId" class="btn btn-secondary">Cancel</a>
</form>
