@model CustomFieldViewModel
@using CourseWork.Models.Enums
@using CourseWork.Models.ViewModels
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Custom Fields";
}

<form asp-action="Edit" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />


    <h3>Custom Fields</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <button type="button" id="add-field" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Field
        </button>
        <div class="text-muted">
            <i class="fas fa-info-circle"></i> Drag fields to reorder. Drag outside to delete.
        </div>
    </div>

    <ul id="fields-list" class="list-group" style="max-height: 500px; overflow-y: auto; min-height: 200px; border: 1px solid #ccc; padding: 10px;">
        @if (Model.Elements != null)
        {
            @for (int i = 0; i < Model.Elements.Count; i++)
            {
                var element = Model.Elements[i];
                <li class="list-group-item field-item" data-field-id="@element.Id" data-index="@i">
                    <input type="hidden" name="Elements[@i].Id" value="@element.Id" />
                    <input type="hidden" name="Elements[@i].Order" value="@i" />

                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="mb-0">
                            <i class="fas fa-grip-vertical text-muted me-2"></i>
                            Field #@(i + 1)
                        </h5>
                        <span class="badge bg-secondary">@element.Type</span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Field Name</label>
                                <input name="Elements[@i].Name" value="@element.Name" class="form-control" required />
                                <span class="text-danger field-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Field Type</label>
                                <select name="Elements[@i].Type" class="form-control type-select">
                                    @foreach (var t in Enum.GetValues(typeof(CustomFieldType)))
                                    {
                                        <option value="@t" @(element.Type == (CustomFieldType)t ? "selected" : "")>@t</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="Elements[@i].Description" class="form-control" rows="2">@element.Description</textarea>
                    </div>

                    <div class="form-check mb-2">
                        <input type="checkbox" name="Elements[@i].ShowInTableView" value="true"
                               class="form-check-input" checked="@element.ShowInTableView" />
                        <label class="form-check-label">Show in Table View</label>
                    </div>

                    <div class="type-desc text-muted small"></div>
                </li>
            }
        }
    </ul>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-save"></i> Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

    <style>
        #fields-list {
            min-height: 200px;
            border: 1px solid #444;
            border-radius: 10px;
            padding: 12px;
            list-style: none;
            background-color: #1e1e1e;
            max-height: 500px;
            overflow-y: auto;
        }

        .field-item {
            margin-bottom: 15px;
            padding: 18px;
            border: 1px solid #333;
            border-radius: 10px;
            background-color: #2a2a2a;
            color: #fff;
            cursor: grab;
            transition: all 0.3s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

            .field-item:hover {
                border-color: #007bff;
                box-shadow: 0 4px 12px rgba(0,123,255,0.3);
            }

            .field-item.sortable-ghost {
                opacity: 0.6;
                background: #333;
                border: 2px dashed #007bff;
            }

            .field-item.sortable-drag {
                opacity: 0.9;
                box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            }

            .field-item input.form-control,
            .field-item select.form-control,
            .field-item textarea.form-control {
                background-color: #333;
                color: #fff;
                border: 1px solid #555;
                border-radius: 6px;
            }

                .field-item input.form-control:focus,
                .field-item select.form-control:focus,
                .field-item textarea.form-control:focus {
                    background-color: #444;
                    border-color: #007bff;
                    box-shadow: 0 0 4px #007bff;
                    outline: none;
                }

            .field-item .badge {
                background-color: #555;
                color: #fff;
            }

        .type-desc {
            font-size: 0.8rem;
            color: #aaa;
            margin-top: 6px;
        }

        .fa-grip-vertical {
            cursor: grab;
            color: #aaa;
        }

        .alert {
            border-radius: 8px;
            padding: 10px 15px;
        }
    </style>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
            const list = document.getElementById('fields-list');
            const addButton = document.getElementById('add-field');

            let draggedItem = null;
            let dragOverItem = null;
            let wasDraggedOut = false;

            function updateOrder() {
                Array.from(list.children).forEach((li, i) => {
                    li.dataset.index = i;
                    li.querySelector('input[name$=".Order"]').value = i;
                    const title = li.querySelector('h5');
                    if (title) title.innerHTML = `<i class="fas fa-grip-vertical text-muted me-2"></i>Field #${i+1}`;
                });
            }

            function initializeField(li) {
                li.setAttribute('draggable', 'true');

                li.addEventListener('dragstart', e => {
                    draggedItem = li;
                    wasDraggedOut = false;
                    li.style.opacity = '0.5';
                });

                li.addEventListener('dragend', e => {
                    li.style.opacity = '1';
                    if (wasDraggedOut && draggedItem) {
                        deleteField(draggedItem);
                    }
                    draggedItem = null;
                    wasDraggedOut = false;
                });

                li.addEventListener('dragover', e => e.preventDefault());

                li.addEventListener('dragenter', e => {
                    e.preventDefault();
                    if (li !== draggedItem) {
                        li.style.backgroundColor = '#e3f2fd';
                        dragOverItem = li;
                    }
                });

                li.addEventListener('dragleave', e => {
                    if (li === dragOverItem) {
                        li.style.backgroundColor = '#fff';
                        dragOverItem = null;
                    }
                });

                li.addEventListener('drop', e => {
                    e.preventDefault();
                    if (li !== draggedItem && draggedItem) {
                        li.style.backgroundColor = '#fff';
                        const items = Array.from(list.children);
                        const draggedIndex = items.indexOf(draggedItem);
                        const targetIndex = items.indexOf(li);
                        if (draggedIndex < targetIndex) {
                            list.insertBefore(draggedItem, li.nextSibling);
                        } else {
                            list.insertBefore(draggedItem, li);
                        }
                        updateOrder();
                    }
                });
            }

            function deleteField(fieldElement) {
                const fieldId = fieldElement.dataset.fieldId;

                if (fieldId !== '0') {
  
                    fieldElement.classList.add('deleting');
                    fetch('/CustomField/Delete?id=' + fieldId, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                    }).then(res => {
                        if (res.ok) { setTimeout(() => { fieldElement.remove(); updateOrder(); }, 300); }
                        else { fieldElement.classList.remove('deleting'); console.error('Error deleting field'); }
                    }).catch(err => { fieldElement.classList.remove('deleting'); console.error(err); });
                } else {
    
                    fieldElement.classList.add('deleting');
                    setTimeout(() => { fieldElement.remove(); updateOrder(); }, 300);
                }
            }


            document.addEventListener('dragover', e => {
                if (!draggedItem) return;
                const rect = list.getBoundingClientRect();
                wasDraggedOut = e.clientX < rect.left - 10 || e.clientX > rect.right + 10 || e.clientY < rect.top - 10 || e.clientY > rect.bottom + 10;
                draggedItem.style.backgroundColor = wasDraggedOut ? '#ffebee' : '#fff';
                e.preventDefault();
            });

            document.addEventListener('drop', e => e.preventDefault());

            Array.from(list.children).forEach(li => initializeField(li));
            updateOrder();

            addButton.addEventListener('click', function() {
                const index = list.children.length;
                const li = document.createElement('li');
                li.className = 'list-group-item field-item';
                li.dataset.index = index;
                li.dataset.fieldId = '0';
                li.innerHTML = `
                    <input type="hidden" name="Elements[${index}].Id" value="0" />
                    <input type="hidden" name="Elements[${index}].Order" value="${index}" />
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="mb-0"><i class="fas fa-grip-vertical text-muted me-2"></i>New Field</h5>
                        <span class="badge bg-secondary">Text</span>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Field Name</label>
                                <input name="Elements[${index}].Name" class="form-control" required />
                                <span class="text-danger field-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Field Type</label>
                                <select name="Elements[${index}].Type" class="form-control type-select">
        @foreach (var t in Enum.GetValues(typeof(CustomFieldType)))
        {
            <option value="@t">@t</option>
        }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="Elements[${index}].Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="Elements[${index}].ShowInTableView" value="true" class="form-check-input" checked />
                        <label class="form-check-label">Show in Table View</label>
                    </div>
                    <div class="type-desc text-muted small"></div>
                `;
                list.appendChild(li);
                initializeField(li);
                updateOrder();
                li.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });

    </script>
}
